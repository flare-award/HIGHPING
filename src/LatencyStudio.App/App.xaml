<Application x:Class="LatencyStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F16" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111925" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#151F2E" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#263244" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3987FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#55A0FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5FB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA8BA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65758B" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#44D3A5" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F3B95F" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B7A" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Application.Resources>
</Application>
